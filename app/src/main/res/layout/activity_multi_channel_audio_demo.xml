<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="@dimen/paddingLeft"
    tools:context=".activity.MultiChannelAudioDemoActivity">

    <TextView
        android:layout_marginStart="@dimen/dimen_24dip"
        android:layout_marginTop="@dimen/dimen_24dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:text="三维环绕声格式查询Demo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dip"
        android:orientation="horizontal">

        <Button
            android:id="@+id/initSdkButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="初始化SDK"
            android:background="@drawable/button_background"
            android:textColor="@color/icActive"
            android:textSize="@dimen/dimen_14sp" />

        <Button
            android:id="@+id/isMultiChannelSupportedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8dip"
            android:text="是否支持三维环绕声"
            android:background="@drawable/button_background"
            android:textColor="@color/icActive"
            android:textSize="@dimen/dimen_14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dip"
        android:orientation="horizontal">

        <Button
            android:id="@+id/queryFormatButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查询三维环绕声格式"
            android:background="@drawable/button_background"
            android:textColor="@color/icActive"
            android:textSize="@dimen/dimen_14sp" />

        <Button
            android:id="@+id/registerListenerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8dip"
            android:text="注册格式变化监听"
            android:background="@drawable/button_background"
            android:textColor="@color/icActive"
            android:textSize="@dimen/dimen_14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dip"
        android:orientation="horizontal">

        <Button
            android:id="@+id/unregisterListenerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消注册监听"
            android:background="@drawable/button_background"
            android:textColor="@color/icActive"
            android:textSize="@dimen/dimen_14sp" />

        <Button
            android:id="@+id/destroyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8dip"
            android:text="销毁释放资源"
            android:background="@drawable/button_background"
            android:textColor="@color/icActive"
            android:textSize="@dimen/dimen_14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_8dip"
        android:layout_marginStart="@dimen/dimen_8dip"
        android:layout_marginTop="@dimen/dimen_16dip"
        android:orientation="vertical"
        android:background="@color/colorTextBackground">

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dip"
            android:hint="状态信息"
            android:textColor="@color/colorHint"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="sans" />

        <TextView
            android:id="@+id/resultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_8dip"
            android:layout_marginTop="@dimen/dimen_8dip"
            android:hint="查询结果显示"
            android:textColor="@color/colorHint"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="sans" />

        <TextView
            android:id="@+id/listenerTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_8dip"
            android:hint="监听回调结果显示"
            android:textColor="@color/colorHint"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="sans" />
    </LinearLayout>

</LinearLayout>
